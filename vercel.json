{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/prompt",
      "destination": "/404/",
      "permanent": false
    },
    {
      "source": "/prompt/:path*",
      "destination": "/404/",
      "permanent": false
    },
    {
      "source": "/posts/:slug*",
      "destination": "/:slug*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/prompt/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.ico|robots.txt|sitemap.xml|feed.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
